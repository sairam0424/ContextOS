{
  "name": "@context-os/cli",
  "version": "1.0.1",
  "description": "ContextOS Developer Interface Layer",
  "keywords": [
    "context-os",
    "mcp",
    "ai-agents",
    "workspace-intelligence"
  ],
  "homepage": "https://github.com/sairam0424/ContextOS",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "bin": {
    "context-os": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node ../scripts/sync-templates.js",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "test": "mocha dist/tests/**/*.test.js",
    "validate": "node dist/index.js validate"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^13.1.0",
    "execa": "^9.5.2",
    "front-matter": "^4.0.2",
    "fs-extra": "^11.2.0",
    "ora": "^8.0.1",
    "@context-os/core": "1.0.1"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "chai": "^5.2.0",
    "mocha": "^11.1.0",
    "typescript": "^5.8.2"
  }
}
