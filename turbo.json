{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**", "**/*.tsbuildinfo"]
    },
    "lint": {
      "inputs": ["src/**", "eslint.config.*", "tsconfig.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "inputs": ["src/**"],
      "outputs": ["coverage/**"]
    },
    "validate": {
      "dependsOn": ["build"],
      "cache": false
    },
    "sync:assets": {
      "cache": false
    }
  }
}
