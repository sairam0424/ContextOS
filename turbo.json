{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "validate": {
      "dependsOn": ["build"],
      "cache": false
    },
    "sync:assets": {
      "cache": false
    }
  }
}
