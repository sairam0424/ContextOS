{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "mocha",
      "node"
    ],
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "sourceMap": true
  },
  "include": [
    "src/**/*"
  ]
}
