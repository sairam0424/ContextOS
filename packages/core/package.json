{
  "name": "@context-os/core",
  "version": "1.13.0",
  "description": "Shared intelligence layer, schemas, and security buckets for ContextOS",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "default": "./dist/factory.js"
    },
    "./container": {
      "types": "./dist/container/index.d.ts",
      "default": "./dist/container/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "mocha dist/tests/**/*.test.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov mocha dist/tests/**/*.test.js",
    "validate": "exit 0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^4.0.3",
    "front-matter": "^4.0.2",
    "fs-extra": "^11.2.0",
    "js-yaml": "^3.14.2",
    "pino": "^10.3.1",
    "sqlite-vec": "^0.1.9",
    "tree-sitter": "^0.21.1",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^5.2.3",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.9",
    "c8": "^10.1.3",
    "chai": "^5.2.0",
    "mocha": "^11.1.0",
    "typescript": "^5.8.2"
  }
}
