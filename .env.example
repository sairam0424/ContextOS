# ContextOS Environment Variables

# Optional: Gemini API key for AI-powered embeddings and repairs
# Without this, the system uses local transformer models (slower but free)
# GEMINI_API_KEY=your-api-key-here

# Optional: Log level (debug, info, warn, error)
# CONTEXTOS_LOG_LEVEL=info

# MCP HTTP Server Configuration
# Required when running the HTTP transport (workspace-mcp)
MCP_AUTH_TOKEN=your-secret-token-here
# MCP_HTTP_PORT=3001
# MCP_AUTH_REQUIRED=true
# MCP_CORS_ORIGINS=https://your-app.com
